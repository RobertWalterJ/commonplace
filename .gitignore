# The downloaded Commons originals — 180MB of full-size JPEGs that exist only
# so encode_images.py has something to work from. They are re-fetchable and must
# never reach a repository; app/img holds the 27MB of WebP that actually ships.
sources/img-cache/

# The cached Folger texts and the Wikidata pull are deliberately NOT ignored.
# They are small, and keeping them means the data build is reproducible offline
# and always parses the exact same bytes.

# The inlined-image payload for the single-file Artifact build: 10MB of
# base64 that is regenerated by make_artifact_images.py in seconds.
build/.cache/

node_modules/
dist/
.DS_Store
Thumbs.db
